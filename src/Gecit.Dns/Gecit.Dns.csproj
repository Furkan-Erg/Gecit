<Project Sdk="Microsoft.NET.Sdk">

  <!-- The encrypted-DNS forwarder: runs as the GecitDNS Windows service, or with dash-dash-console for testing.
       Also a library for the UI (provider list, DoH client, benchmark helpers). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gecit.Dns</RootNamespace>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

</Project>
