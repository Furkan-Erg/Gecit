<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gecit</RootNamespace>
    <AssemblyName>Gecit</AssemblyName>
    <ApplicationIcon>Assets\gecit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Geçit</Product>
    <Company>Geçit</Company>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- The WebView2 package also references its WPF control; this is a WinForms app. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gecit.Dns\Gecit.Dns.csproj" />
  </ItemGroup>

  <!-- The GecitDNS service runs from its own folder; ship its build output as dnssvc\. -->
  <Target Name="CopyDnsService" AfterTargets="Build">
    <ItemGroup>
      <DnsServiceFiles Include="$(MSBuildThisFileDirectory)..\Gecit.Dns\$(OutputPath)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DnsServiceFiles)" DestinationFolder="$(OutDir)dnssvc" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\gecit.ico" LogicalName="gecit.ico" />
    <EmbeddedResource Include="Assets\gecit-off.ico" LogicalName="gecit-off.ico" />
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\goodbyedpi\**\*" Link="dpi\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
